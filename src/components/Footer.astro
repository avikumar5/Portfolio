---
import SplitTextHover from "./SplitTextHover.astro";

const socials = [
  {
    name: "Linkedin",
    href: "https://linkedin.com",
    faClass: "fa-brands fa-linkedin",
  },
  {
    name: "Github",
    href: "https://github.com",
    faClass: "fa-brands fa-github",
  },
  {
    name: "Instagram",
    href: "https://instagram.com",
    faClass: "fa-brands fa-instagram",
  },
];

const email = "avi052001@gmail.com";
---

<footer
  id="contact"
  class="relative px-6 py-20 md:px-12 border-t border-zinc-900 overflow-hidden"
>
  <div
    class="mx-auto max-w-[1600px] flex flex-col justify-between min-h-[45vh] relative z-10"
  >
    <!-- Top Row: Tagline & Large Email -->
    <div
      class="flex flex-col lg:flex-row lg:justify-between lg:items-center gap-8 pb-16 border-b border-zinc-900/60"
    >
      <div class="max-w-sm">
        <p
          class="font-body text-base sm:text-lg text-zinc-400 font-medium leading-relaxed"
        >
          Focused on the intersection of AI and immersive web engineering.
        </p>
      </div>
      <div class="flex items-center gap-3 sm:gap-4">
        <a
          href={`mailto:${email}`}
          class="font-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-medium tracking-tight text-white hover:text-zinc-400 transition-colors duration-300 select-all"
        >
          {email}
        </a>
        <button
          id="copy-email-btn"
          class="relative flex items-center justify-center p-2 sm:p-2.5 rounded-full border border-zinc-800/80 text-zinc-400 hover:text-white hover:border-zinc-500 transition-all duration-300 cursor-pointer focus:outline-none group"
          aria-label="Copy Email"
          data-email={email}
        >
          <!-- Copy icon -->
          <svg
            id="copy-icon"
            class="h-4 w-4 sm:h-5 sm:w-5 transition-all duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
          <!-- Check icon -->
          <svg
            id="check-icon"
            class="h-4 w-4 sm:h-5 sm:w-5 hidden text-green-400 transition-all duration-200"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>

          <!-- Tooltip -->
          <span
            class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-zinc-950 border border-zinc-800 text-[10px] sm:text-xs font-medium font-body text-zinc-300 rounded shadow-xl opacity-0 scale-95 pointer-events-none transition-all duration-200 group-hover:opacity-100 group-hover:scale-100 whitespace-nowrap z-20"
            id="copy-tooltip"
          >
            Copy email
          </span>
        </button>
      </div>
    </div>

    <!-- Middle Row: Outlined Social Pills & Back to Top -->
    <div class="flex flex-row justify-between items-center py-16">
      <!-- Outlined Social Pills -->
      <div class="flex flex-wrap gap-3">
        {
          socials.map((soc) => (
            <a
              href={soc.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-5 py-2.5 border border-zinc-800/80 rounded-full font-body text-xs font-bold tracking-wider text-zinc-300 hover:text-white hover:border-zinc-500 transition-all duration-300"
            >
              <i class={`${soc.faClass} text-sm`} />
              <span>{soc.name}</span>
            </a>
          ))
        }
      </div>

      <!-- Circular Back to Top Button -->
      <button
        id="back-to-top"
        class="w-12 h-12 rounded-full border border-zinc-800 hover:border-zinc-500 flex items-center justify-center text-zinc-400 hover:text-white transition-all duration-300 cursor-pointer"
        aria-label="Back to Top"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </button>
    </div>

    <!-- Bottom Row: Copyright -->
    <div class="text-center pt-3 border-t border-zinc-900/40">
      <p class="text-xs text-zinc-500 font-medium font-body tracking-wider">
        copyright @{new Date().getFullYear()}. all rights reserved
      </p>
    </div>
  </div>

  <!-- Giant Background Name Typography -->
  <div
    class="absolute bottom-0 left-0 right-0 w-full overflow-hidden pointer-events-none select-none z-0 translate-y-[35%] opacity-[0.03]"
  >
    <h4
      class="font-heading text-[12vw] sm:text-[14vw] font-black text-center text-white tracking-tighter uppercase leading-none"
    >
      kshitiz kumar
    </h4>
  </div>
</footer>

<script>
  // Back to Top Smooth Scroll
  const backToTopBtn = document.getElementById("back-to-top");
  if (backToTopBtn) {
    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });
  }

  // Copy Email to Clipboard
  const copyEmailBtn = document.getElementById("copy-email-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");
  const copyTooltip = document.getElementById("copy-tooltip");

  if (copyEmailBtn && copyIcon && checkIcon && copyTooltip) {
    copyEmailBtn.addEventListener("click", async () => {
      const emailText = copyEmailBtn.getAttribute("data-email");
      if (!emailText) return;

      try {
        await navigator.clipboard.writeText(emailText);

        // Show success state
        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");
        copyTooltip.textContent = "Copied!";
        copyEmailBtn.classList.add("border-green-500/50");

        // Reset state after 2 seconds
        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
          copyTooltip.textContent = "Copy email";
          copyEmailBtn.classList.remove("border-green-500/50");
        }, 2000);
      } catch (err) {
        console.error("Failed to copy email: ", err);
      }
    });
  }
</script>
