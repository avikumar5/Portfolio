---
import SplitText from "./SplitText.astro";
import SplitTextHover from "./SplitTextHover.astro";
---

<section
  id="hero"
  class="relative flex min-h-[90vh] flex-col justify-center border-b border-zinc-900 px-6 py-12 md:px-12 lg:px-24"
>
  <div
    class="mx-auto flex w-full max-w-[1600px] flex-col items-start justify-center"
  >
    <!-- Status Indicator -->
    <div class="flex items-center gap-2 mb-6 select-none">
      <span class="h-2 w-2 rounded-full bg-[#4ade80]"></span>
      <span
        class="text-xs font-bold uppercase tracking-widest text-zinc-500 font-mono"
        >Open to work</span
      >
    </div>

    <!-- Main Heading (Animate on Load) -->
    <SplitText
      as="h1"
      trigger="load"
      delay={0}
      class="font-heading text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold leading-[1.15] tracking-tight text-white mb-6"
    >
      Hello, I'm
      <img
        src="/hero_icon.webp"
        alt="Avatar"
        class="inline-block h-16 w-16 sm:h-24 sm:w-24 md:h-28 md:w-28 lg:h-36 lg:w-36 mx-2 relative -top-2 sm:-top-4 md:-top-6 lg:-top-8 -my-2 sm:-my-4 md:-my-6 lg:-my-8 object-cover align-middle"
      />
      Kshitiz Kumar <br />
      <span class="typewriter-container inline-flex items-center">
        <span class="typewriter-text text-white">Full-Stack Developer</span
        ><span
          class="typewriter-cursor select-none ml-1 inline-block w-[3px] h-[0.85em] bg-white align-middle"
        ></span>
      </span>
    </SplitText>

    <!-- Description Subtitle (Animate on Load with Offset) -->
    <SplitText
      as="p"
      trigger="load"
      delay={200}
      class="font-body text-base sm:text-lg md:text-xl text-zinc-400 max-w-2xl mb-8 leading-relaxed"
    >
      Transforming complex problems into elegant, scalable solutions
    </SplitText>

    <!-- Call to Action -->
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="inline-block group border border-white bg-white px-6 py-3.5 text-sm font-bold text-black rounded-xl hover:bg-black hover:text-white transition-all duration-300 shadow-md shadow-white/5"
      >
        <SplitTextHover text="Contact Me!" />
      </a>
      <a
        href="/kshitiz_resume.pdf"
        download="kshitiz_resume.pdf"
        id="resume-download-link"
        class="inline-block group border border-zinc-700 bg-transparent px-6 py-3.5 text-sm font-bold text-white rounded-xl hover:bg-white hover:text-black hover:border-white transition-all duration-300 shadow-md"
      >
        <SplitTextHover text="Resume" />
      </a>
    </div>
  </div>
</section>

<style>
  .typewriter-cursor {
    animation: blink 0.8s step-end infinite;
  }
  @keyframes blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { TextPlugin } from "gsap/TextPlugin";
  import { trackEvent } from "../lib/analytics";

  gsap.registerPlugin(TextPlugin);

  document.addEventListener("DOMContentLoaded", () => {
    const resumeLink = document.getElementById("resume-download-link");
    resumeLink?.addEventListener("click", () => {
      trackEvent("resume_download", { link_location: "hero" });
    });

    const textEl = document.querySelector(".typewriter-text");
    if (!textEl) return;

    const startTypewriter = () => {
      const tl = gsap.timeline({ repeat: -1 });

      tl.to(textEl, {
        duration: 0.8,
        text: "",
        ease: "none",
        delay: 1.5,
      })
        .to(textEl, {
          duration: 0.8,
          text: "AI/ML Developer",
          ease: "none",
        })
        .to(textEl, {
          duration: 0.8,
          text: "",
          ease: "none",
          delay: 1.5,
        })
        .to(textEl, {
          duration: 0.8,
          text: "Full-Stack Developer",
          ease: "none",
        });
    };

    const preloader = document.getElementById("preloader");
    if (preloader && preloader.style.display !== "none") {
      window.addEventListener(
        "preloader-complete",
        () => {
          setTimeout(startTypewriter, 1300);
        },
        { once: true },
      );
    } else {
      setTimeout(startTypewriter, 1200);
    }
  });
</script>
