---
const experiences = [
  {
    period: '2024 — Present',
    company: 'Nexus Tech Systems',
    role: 'Lead Frontend Developer',
    location: 'San Francisco, CA (Remote)',
    description: 'Spearheaded development of a high-performance web dashboard resulting in a 40% loading speed increase. Standardized internal component library using Astro and Tailwind.',
    tags: ['Astro', 'TypeScript', 'Tailwind CSS', 'Vite', 'React']
  },
  {
    period: '2022 — 2024',
    company: 'Apex Digital Agency',
    role: 'Senior Software Engineer',
    location: 'New Delhi, IN',
    description: 'Designed and built accessible user interfaces for e-commerce platforms. Oversaw migration of legacy systems to modern web applications, focusing on SEO and performance.',
    tags: ['Next.js', 'React', 'Tailwind', 'Node.js', 'GraphQL']
  },
  {
    period: '2021 — 2022',
    company: 'ByteCraft Solutions',
    role: 'Web Developer',
    location: 'Bangalore, IN',
    description: 'Implemented pixel-perfect responsive layouts based on design mockups. Integrated external REST APIs and structured state management layers.',
    tags: ['JavaScript', 'HTML5', 'CSS3', 'Vue.js', 'Sass']
  }
];
---

<section id="experience" class="border-b border-zinc-900 px-6 py-20 md:px-12 md:py-32">
  <div class="mx-auto max-w-[1600px]">

    <!-- Section Identifier -->
    <div class="mb-12 flex items-center justify-between border-b border-zinc-900 pb-4">
      <h2 class="font-heading text-xs font-bold uppercase tracking-widest text-zinc-500">02 / WORK EXPERIENCE</h2>
      <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">History</span>
    </div>

    <!-- Timeline Layout -->
    <div class="relative pl-0 md:pl-6">
      <!-- Vertical line down the left on larger viewports -->
      <div class="absolute left-0 top-0 bottom-0 hidden w-px bg-zinc-900 md:block"></div>

      <div class="space-y-16">
        {experiences.map(exp => (
          <div class="relative grid grid-cols-1 gap-6 md:grid-cols-12 group">
            
            <!-- Bullet node on timeline -->
            <div class="absolute left-[-28px] top-1.5 hidden h-3 w-3 rounded-full border-2 border-zinc-800 bg-black group-hover:border-white transition-colors duration-300 md:block"></div>

            <!-- Date / Period Column -->
            <div class="md:col-span-3">
              <span class="font-body text-sm font-semibold uppercase tracking-wider text-zinc-400 font-mono">
                {exp.period}
              </span>
            </div>

            <!-- Detail Column -->
            <div class="md:col-span-9 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-white group-hover:text-zinc-300 transition-colors duration-200">
                  {exp.role}
                </h3>
                <span class="text-xs text-zinc-500 font-medium">
                  {exp.company} &bull; {exp.location}
                </span>
              </div>
              
              <p class="font-body text-sm leading-relaxed text-zinc-400">
                {exp.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 pt-2">
                {exp.tags.map(tag => (
                  <span class="border border-zinc-900 bg-zinc-950 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-zinc-400">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>
