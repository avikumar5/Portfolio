---
const experiences = [
  {
    period: 'May 2025 — Present',
    company: 'Manysphere Technologies Pvt. Ltd.',
    logoSrc: '/manysphere_logo.svg',
    role: 'Full Stack Developer',
    description: [
      '<strong>HRMS SaaS Platform</strong>: Built a multi-tenant HRMS SaaS platform using <strong>React 19</strong>, <strong>Vite</strong>, <strong>Redux</strong>, <strong>NestJS 11</strong>, <strong>PostgreSQL</strong>, and <strong>AWS S3</strong>, reducing HR processing time by <strong>40%</strong> through automated attendance, payroll, and shift workflows while enabling scalable onboarding of multiple organizations with role-based access control.',
      '<strong>VTT CRM</strong>: Worked on a multi-tenant CRM/ERP using <strong>Yii2</strong>, <strong>PHP 8</strong>, <strong>MySQL 8</strong>, <strong>AWS S3</strong>, and <strong>REST APIs</strong>, automating procurement, site operations, and reporting workflows. Implemented RBAC, document generation, and email notifications, reducing manual effort by <strong>30%+</strong> while supporting scalable enterprise operations.',
      '<strong>Frontend Websites</strong>: Built and deployed responsive production websites using <strong>React</strong>, <strong>Next.js</strong>, <strong>Tailwind CSS</strong>, and <strong>Headless CMS (Strapi, Payload)</strong>. Developed animation-rich user interfaces with <strong>GSAP</strong>, <strong>Three.js</strong>, and <strong>Lenis</strong> for smooth interactions and modern user experiences, while optimizing applications for <strong>performance</strong>, <strong>responsiveness</strong>, and <strong>SEO</strong>.'
    ],
    tags: [
      { name: 'React', iconClass: 'devicons devicons-react' },
      { name: 'Redux', iconClass: 'devicons devicons-redux' },
      { name: 'Nest.js', iconClass: 'devicons devicons-nestjs' },
      { name: 'PHP', iconClass: 'devicons devicons-php' },
      { name: 'PostgreSQL', iconClass: 'devicons devicons-postgresql' },
      { name: 'AWS', iconClass: 'devicons devicons-aws' },
      { name: 'Next.js', iconClass: 'devicons devicons-nextjs' },
      { name: 'Tailwind', iconClass: 'devicons devicons-tailwind' },
      { name: 'GSAP', iconClass: 'devicons devicons-greensock' },
      { name: 'Three.js', iconClass: 'devicons devicons-threejs' }
    ]
  },
  {
    period: 'May 2023 — July 2023',
    company: 'Nasscom',
    logoSrc: '/nasscom_logo.svg',
    role: 'Internship',
    description: [
      '<strong>Vehicle Detection Count</strong>: Developed a <strong>Vehicle Detection and Counting System</strong> using <strong>Python</strong>, <strong>OpenCV</strong>, and <strong>HAAR Cascade</strong> for real-time traffic analysis. Successfully processed and classified <strong>1,500+</strong> vehicles with <strong>95% detection</strong> accuracy using image processing techniques, and generated automated analytical reports to provide actionable traffic insights and support data-driven decision-making.'
    ],
    tags: [
      { name: 'Python', iconClass: 'devicons devicons-python' },
      { name: 'OpenCV', iconClass: 'devicons devicons-opencv' }
    ]
  }
];
---

<section id="experience" class="border-b border-zinc-900 px-6 py-20 md:px-12 ">
  <div class="mx-auto max-w-[1600px]">

    <!-- Section Identifier -->
    <div class="mb-16 flex items-center justify-between border-b border-zinc-900 pb-4">
      <h2 class="font-heading text-xs font-bold uppercase tracking-widest text-zinc-500">02 / WORK EXPERIENCE</h2>
      <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">History</span>
    </div>

    <!-- Timeline Layout -->
    <div class="relative pl-0 md:pl-12">
      <!-- Vertical line down the left on larger viewports -->
      <div class="absolute left-[16px] top-0 bottom-0 hidden w-[2px] bg-zinc-900 md:block"></div>

      <div class="space-y-20">
        {experiences.map(exp => (
          <div class="relative grid grid-cols-1 gap-6 md:grid-cols-12 group">
            
            <!-- Bullet node on timeline -->
            <div class="absolute left-[-42px] top-1.5 hidden h-5 w-5 rounded-full border-[3px] border-zinc-700 bg-black group-hover:border-white transition-all duration-300 md:block"></div>

            <!-- Date / Period Column -->
            <div class="md:col-span-3">
              <span class="font-body text-sm font-semibold uppercase tracking-wider text-zinc-400 font-mono">
                {exp.period}
              </span>
            </div>

            <!-- Detail Column -->
            <div class="md:col-span-9 space-y-4">
              <!-- Role & Styled Company Badge -->
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-white group-hover:text-zinc-300 transition-colors duration-200 leading-none">
                  {exp.role} <span class="text-zinc-500 font-medium lowercase">at</span>
                </h3>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800 text-xs font-semibold text-white leading-none">
                  <!-- Company Logo -->
                  {exp.logoSrc && (
                    <img 
                      src={exp.logoSrc} 
                      alt={`${exp.company} Logo`} 
                      class="w-4 h-4 object-contain rounded-sm"
                    />
                  )}
                  <span>{exp.company}</span>
                </span>
              </div>
              
              <!-- Bulleted Descriptions -->
              <ul class="list-disc pl-5 space-y-3 text-zinc-400 font-body text-sm leading-relaxed">
                {exp.description.map(point => (
                  <li set:html={point}></li>
                ))}
              </ul>

              <!-- Skills / Icons Row -->
              <div class="flex flex-wrap gap-x-6 gap-y-3 pt-4 border-t border-zinc-950">
                {exp.tags.map(tag => (
                  <div class="flex items-center gap-2 text-zinc-400 hover:text-white transition-colors duration-200">
                    <i class={`${tag.iconClass} text-base`}></i>
                    <span class="text-xs font-semibold font-body">{tag.name}</span>
                  </div>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  @import "https://cdn.jsdelivr.net/npm/devicons@2.0.1/dist/devicons.css";
</style>
