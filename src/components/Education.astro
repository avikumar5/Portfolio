---
const educationList = [
  {
    degree: 'B.Tech — Computer Science',
    institution: 'Raj Kumar Goel Institute of Technology',
    period: '2020 — 2024  ',
  }
];

const certifications = [
  { 
    name: 'Programming in Python', 
    issuer: 'Meta',
    href: 'https://drive.google.com/file/d/1iE06DxpBH7-8gxcpfJEybWvidRr5G1d9/view?usp=sharing'
  }
];
---

<section id="education" class="border-b border-zinc-900 px-6 py-20 md:px-12 md:py-32">
  <div class="mx-auto max-w-[1600px]">

    <!-- Section Identifier -->
    <div class="mb-12 flex items-center justify-between border-b border-zinc-900 pb-4">
      <h2 class="font-heading text-xs font-bold uppercase tracking-widest text-zinc-500">04 / EDUCATION & ACCREDITATIONS</h2>
      <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">Academic</span>
    </div>

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Degrees List (Left Column) -->
      <div class="lg:col-span-7 space-y-8">
        <h3 class="font-heading text-sm font-semibold uppercase tracking-widest text-zinc-500 mb-6">Degrees</h3>
        <div class="space-y-8">
          {educationList.map(edu => (
            <div class="border-l border-zinc-800 pl-6 space-y-2 relative group">
              <!-- Inline hover node marker -->
              <div class="absolute left-[-4.5px] top-1.5 h-2 w-2 rounded-full bg-zinc-800 group-hover:bg-white transition-colors duration-300"></div>
              
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h4 class="font-heading text-lg font-bold uppercase text-white group-hover:text-zinc-300 transition-colors duration-200">
                  {edu.degree}
                </h4>
                <span class="text-xs text-zinc-500 font-mono font-semibold">{edu.period}</span>
              </div>
              <div class="text-xs font-medium text-zinc-400">{edu.institution}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications (Right Column) -->
      <div class="lg:col-span-5 space-y-6">
        <h3 class="font-heading text-sm font-semibold uppercase tracking-widest text-zinc-500 mb-6">Certifications</h3>
        <div class="grid grid-cols-1 gap-4">
          {certifications.map(cert => {
            const Container = cert.href ? 'a' : 'div';
            const extraProps = cert.href ? { href: cert.href, target: "_blank", rel: "noopener noreferrer" } : {};
            return (
              <Container 
                {...extraProps}
                class={`border border-zinc-900 bg-zinc-950/40 p-4 transition-all duration-300 flex justify-between items-center group/cert ${cert.href ? 'hover:border-zinc-500 hover:bg-zinc-900/30 cursor-pointer' : 'hover:border-zinc-800'}`}
              >
                <div>
                  <div class="font-heading text-sm font-semibold uppercase text-white group-hover/cert:text-zinc-300 transition-colors">
                    {cert.name}
                  </div>
                  <div class="mt-1 text-[10px] uppercase tracking-widest text-zinc-500 font-medium">
                    {cert.issuer}
                  </div>
                </div>
                {cert.href && (
                  <svg 
                    class="h-4.5 w-4.5 text-zinc-600 group-hover/cert:text-white group-hover/cert:translate-x-0.5 group-hover/cert:-translate-y-0.5 transition-all duration-300" 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke="currentColor" 
                    stroke-width="2.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                )}
              </Container>
            );
          })}
        </div>
      </div>
    </div>

  </div>
</section>
