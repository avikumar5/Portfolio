---
interface Props {
  text: string;
  hoverText?: string;
  class?: string;
  staggerDelay?: number;
  duration?: number;
  align?: "left" | "center";
}

const {
  text,
  hoverText,
  class: className = "",
  staggerDelay = 15,
  duration = 350,
  align = "center",
} = Astro.props;

function getGraphemes(str: string): string[] {
  if (typeof Intl !== 'undefined' && Intl.Segmenter) {
    const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
    return Array.from(segmenter.segment(str)).map(s => s.segment);
  }
  return str.split("");
}

const initialChars = getGraphemes(text);
const targetChars = getGraphemes(hoverText || text);
const justifyClass = align === "left" ? "justify-start" : "justify-center";
---

<span 
  class={`relative inline-grid grid-cols-1 grid-rows-1 overflow-hidden px-1 group/hovertext align-baseline ${className}`}
  style="display: inline-grid !important;"
>
  <!-- First set of characters (Initial Text) -->
  <span class={`col-start-1 row-start-1 flex ${justifyClass} items-baseline`}>
    {initialChars.map((char, index) => (
      <span
        class="inline-block transition-transform ease-[cubic-bezier(0.76,0,0.24,1)] translate-y-[0.07em] group-hover:-translate-y-[150%] group-hover/hovertext:-translate-y-[150%]"
        style={`transition-duration: ${duration}ms; transition-delay: ${index * staggerDelay}ms;`}
      >
        {char === " " ? "\u00A0" : char}
      </span>
    ))}
  </span>
  <!-- Second set of characters (Hover Text) -->
  <span class={`col-start-1 row-start-1 flex ${justifyClass} items-baseline`}>
    {targetChars.map((char, index) => (
      <span
        class="inline-block transition-transform ease-[cubic-bezier(0.76,0,0.24,1)] translate-y-[150%] group-hover:translate-y-[0.07em] group-hover/hovertext:translate-y-[0.07em] font-bold"
        style={`transition-duration: ${duration}ms; transition-delay: ${index * staggerDelay}ms;`}
      >
        {char === " " ? "\u00A0" : char}
      </span>
    ))}
  </span>
</span>
