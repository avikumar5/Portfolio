---
// src/components/MusicWidget.astro
---

<!-- Floating Music Widget (Collapsed State) -->
<div
  id="floating-music-widget"
  class="fixed bottom-6 left-6 z-[999] bg-zinc-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-3.5 shadow-2xl flex items-center gap-3.5 pointer-events-auto cursor-pointer max-w-[300px] w-[280px] select-none active:scale-95 hover:border-zinc-700/60 transition-all duration-300 translate-y-12 opacity-0 hidden"
  data-cursor="click-me"
>
  <!-- Album Cover -->
  <div
    id="music-album-container"
    class="relative w-12 h-12 rounded-full bg-zinc-950 border border-white/5 object-cover overflow-hidden flex-shrink-0 animate-spin-slow animate-spin-paused"
  >
    <img
      id="music-album-art"
      src=""
      alt="Album Art"
      class="w-full h-full object-cover hidden"
    />
    <div
      id="music-art-fallback"
      class="w-full h-full flex items-center justify-center bg-zinc-950 text-zinc-600"
    >
      <svg
        class="w-5 h-5 animate-pulse"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
        ></path>
      </svg>
    </div>
  </div>

  <!-- Track Details -->
  <div class="flex-grow min-w-0">
    <div
      id="music-status-label"
      class="text-[8px] font-bold uppercase tracking-widest text-zinc-500 mb-0.5"
    >
      Last Played
    </div>
    <div
      id="music-track-title"
      class="text-xs font-bold text-white tracking-wide truncate"
    >
      Not Playing
    </div>
    <div
      id="music-track-artist"
      class="text-[10px] text-zinc-400 mt-0.5 truncate"
    >
      Offline
    </div>
  </div>

  <!-- Pulse / Visualizer Indicator -->
  <div
    class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950/40"
  >
    <div
      id="music-visualizer"
      class="hidden flex items-end justify-center gap-[2px] h-3 w-3"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </div>
    <div id="music-static-icon" class="text-zinc-600">
      <svg
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"
        ></path>
      </svg>
    </div>
  </div>
</div>

<!-- Music Stats Panel (Expanded State) -->
<div
  id="music-stats-panel"
  class="fixed bottom-28 left-6 z-[998] bg-zinc-950/95 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-2xl w-[calc(100vw-48px)] max-w-[320px] transition-all duration-300 opacity-0 pointer-events-none translate-y-4 select-none font-body"
>
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-white/5 pb-3 mb-3">
    <div class="flex items-center gap-2">
      <svg
        class="h-4.5 w-4.5 text-[#d51007]"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-3.6 15c-.773 0-1.4-.627-1.4-1.4s.627-1.4 1.4-1.4 1.4.627 1.4 1.4-.627 1.4-1.4 1.4zm0-3.8c-1.325 0-2.4 1.075-2.4 2.4s1.075 2.4 2.4 2.4 2.4-1.075 2.4-2.4-1.075-2.4-2.4-2.4zm7.2 3.8c-.773 0-1.4-.627-1.4-1.4s.627-1.4 1.4-1.4 1.4.627 1.4 1.4-.627 1.4-1.4 1.4zm0-3.8c-1.325 0-2.4 1.075-2.4 2.4s1.075 2.4 2.4 2.4 2.4-1.075 2.4-2.4-1.075-2.4-2.4-2.4z"
        ></path>
      </svg>
      <div>
        <h3 class="font-heading text-[10px] font-bold text-white uppercase tracking-widest">
          Lately Stats
        </h3>
        <p class="text-[9px] text-zinc-500 font-sans mt-0.5">Avibruhhh . Last.fm</p>
      </div>
    </div>
    
    <button
      id="close-music-panel"
      class="text-zinc-400 hover:text-white transition-colors duration-200 cursor-pointer p-1 rounded-full hover:bg-white/5 focus:outline-none"
      aria-label="Close Panel"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Tab Switcher -->
  <div class="flex border border-white/5 p-[2px] bg-zinc-950 rounded-lg mb-3 gap-1">
    <button
      id="tab-btn-songs"
      class="flex-1 text-[9px] font-bold uppercase tracking-wider py-1.5 rounded-md transition-all duration-200 bg-white/10 text-white cursor-pointer"
    >
      Songs
    </button>
    <button
      id="tab-btn-artists"
      class="flex-1 text-[9px] font-bold uppercase tracking-wider py-1.5 rounded-md transition-all duration-200 text-zinc-500 hover:text-zinc-300 cursor-pointer"
    >
      Artists
    </button>
  </div>

  <!-- Content Containers -->
  <div class="min-h-[220px] max-h-[350px] overflow-y-auto pr-0.5 pb-2 custom-scrollbar">
    <!-- Top Weekly Tracks tab -->
    <div id="tab-content-songs" class="space-y-3">
      <div
        id="panel-loader-tracks"
        class="text-zinc-600 text-[10px] py-12 flex items-center justify-center gap-2"
      >
        <svg
          class="animate-spin h-4 w-4 text-zinc-500"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
          ></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        <span>Fetching top songs...</span>
      </div>
      <ul id="panel-list-tracks" class="space-y-2.5 hidden">
        <!-- Dynamically populated -->
      </ul>
    </div>

    <!-- Top Weekly Artists tab -->
    <div id="tab-content-artists" class="space-y-3 hidden">
      <div
        id="panel-loader-artists"
        class="text-zinc-600 text-[10px] py-12 flex items-center justify-center gap-2"
      >
        <svg
          class="animate-spin h-4 w-4 text-zinc-500"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"
          ></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
        <span>Fetching top artists...</span>
      </div>
      <ul id="panel-list-artists" class="space-y-2.5 hidden">
        <!-- Dynamically populated -->
      </ul>
    </div>
  </div>
</div>

<style>
  /* Audio visualizer bar animations */
  .bar {
    display: inline-block;
    width: 2px;
    height: 3px;
    background-color: #22c55e;
    border-radius: 1px;
    animation: visualizer-bounce 0.8s ease-in-out infinite alternate;
  }
  .bar:nth-child(2) {
    animation-delay: 0.15s;
  }
  .bar:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes visualizer-bounce {
    0% {
      height: 3px;
    }
    100% {
      height: 12px;
    }
  }

  /* Rotating Vinyl Animation */
  .animate-spin-slow {
    animation: spin 8s linear infinite;
  }
  .animate-spin-paused {
    animation-play-state: paused;
  }
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Custom scrollbar styling for content container */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  import { gsap } from "gsap";

  const API_KEY = import.meta.env.PUBLIC_LASTFM_API_KEY;
  const USER = import.meta.env.PUBLIC_LASTFM_USERNAME;
  const BASE_URL = "https://ws.audioscrobbler.com/2.0/";

  // Elements
  const widget = document.getElementById("floating-music-widget");
  const albumContainer = document.getElementById("music-album-container");
  const albumArt = document.getElementById("music-album-art") as HTMLImageElement;
  const artFallback = document.getElementById("music-art-fallback");
  const statusLabel = document.getElementById("music-status-label");
  const trackTitle = document.getElementById("music-track-title");
  const trackArtist = document.getElementById("music-track-artist");
  const visualizer = document.getElementById("music-visualizer");
  const staticIcon = document.getElementById("music-static-icon");

  const panel = document.getElementById("music-stats-panel");
  const closePanelBtn = document.getElementById("close-music-panel");

  const tabBtnSongs = document.getElementById("tab-btn-songs");
  const tabBtnArtists = document.getElementById("tab-btn-artists");
  const tabContentSongs = document.getElementById("tab-content-songs");
  const tabContentArtists = document.getElementById("tab-content-artists");

  const loaderTracks = document.getElementById("panel-loader-tracks");
  const listTracks = document.getElementById("panel-list-tracks");
  const loaderArtists = document.getElementById("panel-loader-artists");
  const listArtists = document.getElementById("panel-list-artists");

  let isPanelOpen = false;
  let cache: Record<string, any> = {};
  let isPreloaderActive = !!document.getElementById("preloader");

  window.addEventListener("preloader-complete", () => {
    isPreloaderActive = false;
    if (widget && trackTitle && trackTitle.textContent !== "Not Playing" && widget.classList.contains("hidden")) {
      widget.classList.remove("hidden");
      gsap.to(widget, {
        y: 0,
        opacity: 1,
        duration: 0.8,
        ease: "power3.out",
      });
    }
  });

  function isPlaceholder(url: string | null | undefined) {
    if (!url || url.trim() === "") return true;
    return url.includes("2a96cbd87eeb47d75f299f2756197cdd") || url.includes("lastfm_avatar") || url.includes("default");
  }

  async function fetchLastFmData(method: string, params: Record<string, string> = {}) {
    let url = `${BASE_URL}?method=${method}&user=${USER}&api_key=${API_KEY}&format=json`;
    Object.entries(params).forEach(([k, v]) => {
      url += `&${k}=${v}`;
    });
    const cacheKey = method + JSON.stringify(params);
    if (cache[cacheKey]) return cache[cacheKey];
    try {
      const res = await fetch(url);
      const data = await res.json();
      cache[cacheKey] = data;
      return data;
    } catch (err) {
      console.error(`Last.fm Fetch Error [${method}]: `, err);
      return null;
    }
  }

  // Fetch track details (to get the real album cover) directly from Last.fm
  async function fetchLastFmTrackInfo(trackName: string, artistName: string) {
    const cacheKey = `lastfm_info_${trackName}_${artistName}`;
    if (cache[cacheKey] !== undefined) return cache[cacheKey];

    try {
      const data = await fetchLastFmData("track.getInfo", {
        track: trackName,
        artist: artistName
      });
      if (data && data.track) {
        cache[cacheKey] = data.track;
        return data.track;
      }
    } catch (e) {
      console.error("Last.fm track.getInfo Error: ", e);
    }
    cache[cacheKey] = null;
    return null;
  }

  // Fetch artist image (using their top track's album cover) directly from Last.fm
  async function fetchLastFmArtistImage(artistName: string) {
    const cacheKey = `lastfm_artist_img_${artistName}`;
    if (cache[cacheKey] !== undefined) return cache[cacheKey];

    try {
      const data = await fetchLastFmData("artist.gettoptracks", {
        artist: artistName,
        limit: "1"
      });
      const topTrack = data?.toptracks?.track?.[0];
      if (topTrack) {
        const trackInfo = await fetchLastFmTrackInfo(topTrack.name, artistName);
        const albumUrl = trackInfo?.album?.image?.find(
          (img: any) => img.size === "medium" || img.size === "large"
        )?.["#text"];

        if (albumUrl && !isPlaceholder(albumUrl)) {
          cache[cacheKey] = albumUrl;
          return albumUrl;
        }
      }
    } catch (e) {
      console.error("Last.fm artist image fetch Error: ", e);
    }
    cache[cacheKey] = null;
    return null;
  }

  // Fetch real artwork from iTunes Search API with query normalization
  async function fetchTrackArtwork(trackName: string, artistName: string) {
    const cleanTrack = trackName
      .replace(/\([^)]*\)/g, "") // strip (feat. ...)
      .replace(/\[[^\]]*\]/g, "") // strip [Remix]
      .replace(/\$/g, "s") // A$AP -> ASAP
      .trim();

    const cleanArtist = artistName
      .replace(/\$/g, "s") // A$AP -> ASAP
      .trim();

    const cacheKey = `art_${cleanTrack}_${cleanArtist}`;
    if (cache[cacheKey] !== undefined) return cache[cacheKey];

    try {
      const term = encodeURIComponent(`${cleanArtist} ${cleanTrack}`);
      const res = await fetch(`https://itunes.apple.com/search?term=${term}&entity=song&limit=1`);
      const data = await res.json();
      if (data.results && data.results.length > 0) {
        const artUrl = data.results[0].artworkUrl100;
        const highResUrl = artUrl.replace("100x100bb", "300x300bb");
        cache[cacheKey] = highResUrl;
        return highResUrl;
      }
    } catch (e) {
      console.error("iTunes Search Error: ", e);
    }

    // Fallback search: track title only
    try {
      const term = encodeURIComponent(cleanTrack);
      const res = await fetch(`https://itunes.apple.com/search?term=${term}&entity=song&limit=1`);
      const data = await res.json();
      if (data.results && data.results.length > 0) {
        const artUrl = data.results[0].artworkUrl100;
        const highResUrl = artUrl.replace("100x100bb", "300x300bb");
        cache[cacheKey] = highResUrl;
        return highResUrl;
      }
    } catch (e) {
      console.error("iTunes track-only fallback error: ", e);
    }

    cache[cacheKey] = null;
    return null;
  }

  // Set up polling for currently playing track
  async function pollNowPlaying() {
    const data = await fetchLastFmData("user.getrecenttracks");
    const tracks = data?.recenttracks?.track || [];
    if (tracks.length === 0) return;

    const currentTrack = tracks[0];
    const isNowPlaying = currentTrack["@attr"] && currentTrack["@attr"].nowplaying === "true";

    // Update Widget UI
    if (widget && trackTitle && trackArtist && statusLabel && albumArt && artFallback && visualizer && staticIcon) {
      // 1. Text Info
      trackTitle.textContent = currentTrack.name;
      trackArtist.textContent = currentTrack.artist["#text"];

      // 2. Cover Artwork (Try Last.fm first, fall back to iTunes if it is a placeholder)
      const lastfmUrl = currentTrack.image?.find(
        (img: any) => img.size === "medium" || img.size === "large"
      )?.["#text"];

      if (lastfmUrl && !isPlaceholder(lastfmUrl)) {
        albumArt.src = lastfmUrl;
        albumArt.classList.remove("hidden");
        artFallback.classList.add("hidden");
      } else {
        const itunesArt = await fetchTrackArtwork(currentTrack.name, currentTrack.artist["#text"]);
        if (itunesArt) {
          albumArt.src = itunesArt;
          albumArt.classList.remove("hidden");
          artFallback.classList.add("hidden");
        } else {
          albumArt.classList.add("hidden");
          artFallback.classList.remove("hidden");
        }
      }

      // 3. Status Label & Visualizer
      if (isNowPlaying) {
        statusLabel.textContent = "Now Playing";
        statusLabel.classList.add("text-green-400");
        statusLabel.classList.remove("text-zinc-500");
        
        visualizer.classList.remove("hidden");
        visualizer.classList.add("flex");
        staticIcon.classList.add("hidden");

        // Spin the album art
        if (albumContainer) {
          albumContainer.classList.remove("animate-spin-paused");
        }
      } else {
        statusLabel.textContent = "Last Played";
        statusLabel.classList.add("text-zinc-500");
        statusLabel.classList.remove("text-green-400");

        visualizer.classList.add("hidden");
        visualizer.classList.remove("flex");
        staticIcon.classList.remove("hidden");

        // Pause the spinning album art
        if (albumContainer) {
          albumContainer.classList.add("animate-spin-paused");
        }
      }

      // Reveal widget if hidden (animate in)
      if (widget.classList.contains("hidden") && !isPreloaderActive) {
        widget.classList.remove("hidden");
        gsap.to(widget, {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power3.out",
        });
      }
    }
  }

  // Panel Loader functions
  async function loadPanelData() {
    if (!listTracks || !loaderTracks || !listArtists || !loaderArtists) return;

    listTracks.classList.add("hidden");
    loaderTracks.classList.remove("hidden");
    listArtists.classList.add("hidden");
    loaderArtists.classList.remove("hidden");

    // Fetch in parallel using gettoptracks and gettopartists with period=7day
    const [tracksData, artistsData] = await Promise.all([
      fetchLastFmData("user.gettoptracks", { period: "7day", limit: "5" }),
      fetchLastFmData("user.gettopartists", { period: "7day", limit: "5" })
    ]);

    // 1. Render Weekly Tracks
    const tracks = tracksData?.toptracks?.track || [];
    listTracks.innerHTML = "";
    loaderTracks.classList.add("hidden");
    listTracks.classList.remove("hidden");

    if (tracks.length === 0) {
      listTracks.innerHTML = `<li class="text-zinc-500 text-xs">No top weekly songs found.</li>`;
    } else {
      tracks.forEach((track: any, idx: number) => {
        const li = document.createElement("li");
        li.className = "flex items-center justify-between py-2 border-b border-zinc-900/30 text-zinc-300 font-sans hover:text-white transition-colors duration-200";
        
        const imgId = `track-img-${idx}`;

        // Show loading state and fetch album cover asynchronously from Last.fm
        li.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <span class="text-xs font-mono text-zinc-500 w-4 flex-shrink-0">${idx + 1}</span>
            <div id="${imgId}" class="w-9 h-9 rounded bg-zinc-950 border border-white/5 flex items-center justify-center text-zinc-700 flex-shrink-0 overflow-hidden">
              <svg class="w-4.5 h-4.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
              </svg>
            </div>
            <div class="min-w-0">
              <div class="font-semibold truncate text-white">${track.name}</div>
              <div class="text-[11px] text-zinc-500 truncate mt-0.5">${track.artist.name}</div>
            </div>
          </div>
          <span class="text-[10px] font-mono text-zinc-500 flex-shrink-0 ml-2">${track.playcount} plays</span>
        `;
        listTracks.appendChild(li);

        fetchLastFmTrackInfo(track.name, track.artist.name).then(trackInfo => {
          const imgContainer = document.getElementById(imgId);
          if (imgContainer) {
            const albumUrl = trackInfo?.album?.image?.find(
              (img: any) => img.size === "medium" || img.size === "large"
            )?.["#text"];

            if (albumUrl && !isPlaceholder(albumUrl)) {
              imgContainer.innerHTML = `<img class="w-full h-full object-cover" src="${albumUrl}" alt="${track.name}" />`;
            } else {
              imgContainer.innerHTML = `
                <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
                </svg>
              `;
            }
          }
        });
      });
    }

    // 2. Render Weekly Artists
    const artists = artistsData?.topartists?.artist || [];
    listArtists.innerHTML = "";
    loaderArtists.classList.add("hidden");
    listArtists.classList.remove("hidden");

    if (artists.length === 0) {
      listArtists.innerHTML = `<li class="text-zinc-500 text-xs">No top weekly artists found.</li>`;
    } else {
      artists.forEach((artist: any, idx: number) => {
        const li = document.createElement("li");
        li.className = "flex items-center justify-between py-2 border-b border-zinc-900/30 text-zinc-300 font-sans hover:text-white transition-colors duration-200";
        
        const imgId = `artist-img-${idx}`;
        const initials = artist.name.trim().charAt(0).toUpperCase();

        li.innerHTML = `
          <div class="flex items-center gap-3 min-w-0">
            <span class="text-xs font-mono text-zinc-500 w-4 flex-shrink-0">${idx + 1}</span>
            <div id="${imgId}" class="w-9 h-9 rounded-full bg-zinc-800 border border-white/5 flex items-center justify-center text-zinc-300 font-bold text-xs flex-shrink-0 select-none overflow-hidden">
              ${initials}
            </div>
            <div class="min-w-0">
              <div class="font-semibold truncate text-white">${artist.name}</div>
            </div>
          </div>
          <span class="text-[10px] font-mono text-zinc-500 flex-shrink-0 ml-2">${artist.playcount} plays</span>
        `;
        listArtists.appendChild(li);

        // Fetch artist image asynchronously using their top track's album cover on Last.fm
        fetchLastFmArtistImage(artist.name).then(imgUrl => {
          const imgContainer = document.getElementById(imgId);
          if (imgContainer && imgUrl) {
            imgContainer.innerHTML = `<img class="w-full h-full object-cover" src="${imgUrl}" alt="${artist.name}" />`;
            imgContainer.classList.remove("bg-zinc-800", "text-zinc-300", "font-bold", "text-xs");
          }
        });
      });
    }
  }

  function openPanel() {
    if (isPanelOpen || !panel) return;
    isPanelOpen = true;

    panel.classList.remove("pointer-events-none");

    gsap.to(panel, {
      opacity: 1,
      y: 0,
      duration: 0.4,
      ease: "power3.out"
    });

    loadPanelData();
  }

  function closePanel() {
    if (!isPanelOpen || !panel) return;
    isPanelOpen = false;

    panel.classList.add("pointer-events-none");

    gsap.to(panel, {
      opacity: 0,
      y: 16,
      duration: 0.3,
      ease: "power2.in"
    });
  }

  // Tab Switcher event listeners
  if (tabBtnSongs && tabBtnArtists && tabContentSongs && tabContentArtists) {
    tabBtnSongs.addEventListener("click", () => {
      tabBtnSongs.classList.add("bg-white/10", "text-white");
      tabBtnSongs.classList.remove("text-zinc-500", "hover:text-zinc-300");
      tabBtnArtists.classList.remove("bg-white/10", "text-white");
      tabBtnArtists.classList.add("text-zinc-500", "hover:text-zinc-300");
      
      tabContentSongs.classList.remove("hidden");
      tabContentArtists.classList.add("hidden");
    });

    tabBtnArtists.addEventListener("click", () => {
      tabBtnArtists.classList.add("bg-white/10", "text-white");
      tabBtnArtists.classList.remove("text-zinc-500", "hover:text-zinc-300");
      tabBtnSongs.classList.remove("bg-white/10", "text-white");
      tabBtnSongs.classList.add("text-zinc-500", "hover:text-zinc-300");
      
      tabContentArtists.classList.remove("hidden");
      tabContentSongs.classList.add("hidden");
    });
  }

  // Event Listeners
  if (widget) {
    widget.addEventListener("click", () => {
      if (isPanelOpen) {
        closePanel();
      } else {
        openPanel();
      }
    });
  }

  if (closePanelBtn) {
    closePanelBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      closePanel();
    });
  }

  // Click outside to close panel
  window.addEventListener("click", (e) => {
    if (isPanelOpen && panel && widget) {
      const target = e.target as HTMLElement;
      if (!panel.contains(target) && !widget.contains(target)) {
        closePanel();
      }
    }
  });

  // Escape key to close panel
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePanel();
    }
  });

  // Initial Poll and start loop
  pollNowPlaying();
  setInterval(pollNowPlaying, 15000); // Poll every 15 seconds to keep it active
</script>
