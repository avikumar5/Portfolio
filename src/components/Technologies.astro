---
const techCategories = [
  {
    title: 'Frontend Architecture',
    skills: [
      { name: 'Astro', level: 'Expert' },
      { name: 'React / Next.js', level: 'Expert' },
      { name: 'TypeScript', level: 'Expert' },
      { name: 'Tailwind CSS', level: 'Expert' },
      { name: 'JavaScript (ES6+)', level: 'Expert' },
      { name: 'HTML5 & CSS3', level: 'Expert' }
    ]
  },
  {
    title: 'Backend & Data',
    skills: [
      { name: 'Node.js', level: 'Intermediate' },
      { name: 'Express / Fastify', level: 'Intermediate' },
      { name: 'GraphQL', level: 'Intermediate' },
      { name: 'PostgreSQL', level: 'Intermediate' },
      { name: 'MongoDB', level: 'Intermediate' },
      { name: 'REST APIs', level: 'Expert' }
    ]
  },
  {
    title: 'Workflow & Tools',
    skills: [
      { name: 'Git & GitHub', level: 'Expert' },
      { name: 'Vite / Webpack', level: 'Expert' },
      { name: 'Docker', level: 'Beginner' },
      { name: 'Figma', level: 'Intermediate' },
      { name: 'Linux / Bash', level: 'Intermediate' },
      { name: 'CI/CD Pipelines', level: 'Intermediate' }
    ]
  }
];
---

<section id="technologies" class="border-b border-zinc-900 px-6 py-20 md:px-12 md:py-32">
  <div class="mx-auto max-w-[1600px]">

    <!-- Section Identifier -->
    <div class="mb-12 flex items-center justify-between border-b border-zinc-900 pb-4">
      <h2 class="font-heading text-xs font-bold uppercase tracking-widest text-zinc-500">03 / TECHNICAL SKILLS</h2>
      <span class="text-xs text-zinc-600 uppercase tracking-widest font-mono">Expertise</span>
    </div>

    <!-- Category Grids -->
    <div class="space-y-16">
      {techCategories.map(category => (
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          
          <!-- Category Header -->
          <div class="lg:col-span-4">
            <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-white md:text-2xl">
              {category.title}
            </h3>
          </div>

          <!-- Cards Grid -->
          <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-4">
            {category.skills.map(skill => (
              <div class="border border-zinc-900 bg-zinc-950/40 p-4 md:p-6 group hover:border-white transition-all duration-300">
                <div class="flex items-center justify-between">
                  <span class="font-heading text-sm font-semibold uppercase tracking-wide text-white group-hover:text-white transition-colors duration-200">
                    {skill.name}
                  </span>
                  <span class="text-[9px] uppercase tracking-widest text-zinc-600 font-mono group-hover:text-zinc-400 transition-colors duration-200">
                    {skill.level}
                  </span>
                </div>
                <!-- Custom indicator line -->
                <div class="mt-4 h-[1px] w-full bg-zinc-900 group-hover:bg-zinc-800 transition-colors duration-300"></div>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
