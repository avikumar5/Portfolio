---
const navLinks = [
  { href: '#hero', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#technologies', label: 'Tech' },
  { href: '#education', label: 'Education' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-900 bg-black/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1600px] items-center justify-between px-6 py-4 md:px-12">
    <!-- Logo/Brand -->
    <a href="#hero" class="font-heading text-xl font-bold uppercase tracking-widest text-white transition-colors duration-200 hover:text-zinc-400">
      Developer.
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center space-x-8">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="nav-link text-xs uppercase tracking-wider text-zinc-400 hover:text-white transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a 
        href="#contact" 
        class="border border-white bg-white px-4 py-2 text-xs uppercase tracking-wider font-medium text-black hover:bg-black hover:text-white transition-all duration-300"
      >
        Contact
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-toggle" 
      class="flex h-6 w-6 flex-col justify-between p-1 md:hidden group" 
      aria-label="Toggle Menu"
    >
      <span class="h-[1px] w-full bg-white transition-transform duration-300 origin-left group-aria-expanded:rotate-[45deg] group-aria-expanded:translate-y-[5px]"></span>
      <span class="h-[1px] w-full bg-white transition-opacity duration-300 group-aria-expanded:opacity-0"></span>
      <span class="h-[1px] w-full bg-white transition-transform duration-300 origin-left group-aria-expanded:rotate-[-45deg] group-aria-expanded:translate-y-[-5px]"></span>
    </button>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div 
    id="mobile-menu" 
    class="fixed inset-x-0 top-[57px] hidden border-b border-zinc-900 bg-black px-6 py-8 md:hidden transition-all duration-300 ease-in-out"
  >
    <nav class="flex flex-col space-y-6">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="mobile-nav-link text-sm uppercase tracking-widest text-zinc-400 hover:text-white transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a 
        href="#contact" 
        class="border border-white bg-white px-4 py-3 text-center text-xs uppercase tracking-widest font-medium text-black hover:bg-black hover:text-white transition-all duration-300"
      >
        Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
      }
    });

    // Close menu on link click
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Active section observer
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observerOptions = {
    root: null,
    rootMargin: '-50% 0px -50% 0px', // Trigger when section occupies the middle of viewport
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');
        navLinks.forEach(link => {
          if (link.getAttribute('href') === `#${id}`) {
            link.classList.add('text-white');
            link.classList.remove('text-zinc-400');
          } else {
            link.classList.remove('text-white');
            link.classList.add('text-zinc-400');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => observer.observe(section));
</script>
