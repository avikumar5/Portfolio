---
import SplitTextHover from './SplitTextHover.astro';

const navLinks = [
  { href: '#about', label: 'About me' },
  { href: '#experience', label: 'Experience' },
  { href: '#technologies', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<!-- Desktop Navigation: Floating Pill -->
<div class="fixed top-6 left-1/2 -translate-x-1/2 z-50 hidden md:block w-auto">
  <nav class="flex items-center justify-center gap-8 rounded-full border border-zinc-800 bg-black/90 px-8 py-3.5 backdrop-blur-md shadow-lg shadow-black/85">
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class="nav-link group relative py-1 text-sm font-semibold uppercase tracking-wider text-zinc-400 hover:text-white transition-colors duration-200"
      >
        <SplitTextHover text={link.label} />
        <!-- Active Section Underline (Navy Blue #000080) -->
        <span class="active-indicator absolute bottom-0 left-1/2 -translate-x-1/2 w-4/5 h-[2px] bg-[#000080] scale-x-0 transition-transform duration-300 ease-out origin-center"></span>
      </a>
    ))}
  </nav>
</div>

<!-- Mobile Navigation Header: Floating Pill -->
<div class="fixed top-6 left-6 right-6 z-50 flex md:hidden items-center justify-between rounded-full border border-zinc-800 bg-black/95 px-6 py-4 backdrop-blur-md shadow-lg shadow-black/85">
  <a href="#hero" class="font-heading text-xs font-bold uppercase tracking-wider text-white">
    Developer.
  </a>
  
  <!-- Hamburger Button -->
  <button 
    id="burger-toggle" 
    class="flex h-5 w-6 flex-col justify-between py-1 items-end focus:outline-none" 
    aria-label="Toggle mobile menu"
    aria-expanded="false"
  >
    <span id="line-1" class="h-[1.5px] w-6 bg-white transition-all duration-300 origin-center"></span>
    <span id="line-2" class="h-[1.5px] w-4 bg-white transition-all duration-300 origin-center"></span>
    <span id="line-3" class="h-[1.5px] w-6 bg-white transition-all duration-300 origin-center"></span>
  </button>
</div>

<!-- Mobile Menu Overlay -->
<div 
  id="mobile-overlay" 
  class="fixed inset-0 z-40 flex flex-col justify-center items-center bg-black/95 backdrop-blur-lg translate-y-[-100%] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] md:hidden"
>
  <nav class="flex flex-col items-center gap-8">
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class="mobile-nav-link group font-heading text-3xl font-bold uppercase tracking-widest text-zinc-400 hover:text-white transition-colors duration-200"
      >
        <SplitTextHover text={link.label} />
      </a>
    ))}
  </nav>
</div>

<script>
  // Mobile menu toggle logic
  const burgerToggle = document.getElementById('burger-toggle');
  const mobileOverlay = document.getElementById('mobile-overlay');
  const line1 = document.getElementById('line-1');
  const line2 = document.getElementById('line-2');
  const line3 = document.getElementById('line-3');
  const body = document.body;

  if (burgerToggle && mobileOverlay && line1 && line2 && line3) {
    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      burgerToggle.setAttribute('aria-expanded', isOpen.toString());

      if (isOpen) {
        // Open overlay
        mobileOverlay.classList.remove('translate-y-[-100%]');
        body.style.overflow = 'hidden';

        // Animate Burger to 'X'
        line1.classList.add('translate-y-[6px]', 'rotate-45');
        line2.classList.add('opacity-0', 'scale-x-0');
        line3.classList.add('-translate-y-[6px]', '-rotate-45');
        line3.classList.remove('w-6');
        line3.classList.add('w-6'); // Force standard width
      } else {
        // Close overlay
        mobileOverlay.classList.add('translate-y-[-100%]');
        body.style.overflow = '';

        // Animate 'X' to Burger
        line1.classList.remove('translate-y-[6px]', 'rotate-45');
        line2.classList.remove('opacity-0', 'scale-x-0');
        line3.classList.remove('-translate-y-[6px]', '-rotate-45');
      }
    };

    burgerToggle.addEventListener('click', toggleMenu);

    // Close menu when clicking links
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  }

  // Active section observer (shared between Desktop & Mobile)
  const sections = document.querySelectorAll('section[id], footer[id]');
  const desktopLinks = document.querySelectorAll('.nav-link');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const observerOptions = {
    root: null,
    rootMargin: '-40% 0px -40% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');

        // Update Desktop Links
        desktopLinks.forEach(link => {
          const href = link.getAttribute('href');
          const indicator = link.querySelector('.active-indicator');
          
          if (href === `#${id}`) {
            link.classList.add('text-white');
            link.classList.remove('text-zinc-400');
            if (indicator) {
              indicator.classList.remove('scale-x-0');
              indicator.classList.add('scale-x-100');
            }
          } else {
            link.classList.remove('text-white');
            link.classList.add('text-zinc-400');
            if (indicator) {
              indicator.classList.remove('scale-x-100');
              indicator.classList.add('scale-x-0');
            }
          }
        });

        // Update Mobile Links
        mobileLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (href === `#${id}`) {
            link.classList.add('text-white');
            link.classList.remove('text-zinc-400');
          } else {
            link.classList.remove('text-white');
            link.classList.add('text-zinc-400');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => {
    const id = section.getAttribute('id');
    if (id && ['about', 'experience', 'education', 'technologies', 'contact'].includes(id)) {
      observer.observe(section);
    }
  });

  // Smooth scroll interceptor to prevent URL hash updates
  const allScrollLinks = document.querySelectorAll('a[href^="#"]');
  allScrollLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href');
      if (!targetId || targetId === '#') return;
      const targetElement = document.querySelector(targetId);
      if (targetElement) {
        const lenis = (window as any).lenis;
        if (lenis) {
          lenis.scrollTo(targetElement);
        } else {
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      }
    });
  });
</script>
